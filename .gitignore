# ──────────────────────────────────────────────────────────────
# SpliceVarMech — .gitignore
# ──────────────────────────────────────────────────────────────

# ── Source data (download separately, not for version control) ──
# Keep raw inputs and downloaded external datasets ignored.
# Allow the small processed tables used to reproduce the analyses.
/data/*
*.xlsx
*.csv
*.tsv
*.h5
*.hdf5
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.vcf
*.vcf.gz
*.gtf
*.gtf.gz
*.bam
*.bed
!/data/processed/
!/data/processed/**

# ── Notebooks (checkpoints, outputs) ──
notebooks/.ipynb_checkpoints/
*.ipynb
.ipynb_checkpoints/

# ── IDE / Editor ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ── Virtual environment ──
venv/
.venv/
env/
.env

# ── Experiment artifacts ──
# Model checkpoints and saved results are eligible for version control.
# Keep transient training-service logs and caches ignored.
wandb/
runs/
lightning_logs/

# ── Paper & results (keep locally, not in repo) ──
paper/
TEX11_Clinical_Action_Plan.*
src/pipeline/predict.py
scripts/tex11_case_study.py

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary files ──
*.tmp
*.temp
*.log
*.bak
